# Copy this file to .env and fill in what you have. Either provider can be left empty.

# Google: an API key with the "Routes API" enabled.
GOOGLE_MAPS_API_KEY=

# Apple, option 1: paste a Maps token (a JWT) made in your Apple Developer account.
APPLE_MAPS_TOKEN=

# Apple, option 2: let the server sign its own tokens from a Maps key (.p8 file).
APPLE_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

PORT=3000
